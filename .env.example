# Copy this file to .env and fill in real values. .env is ignored by git.

# Azure Key Vault holding the on-prem SQL password (secret: onprem-sql-sa-password).
# The vault NAME is not a secret; access is controlled by Entra ID roles.
KEY_VAULT_NAME=kv-dnb-dev-xxxxxxxx

# Only if you run WITHOUT Azure: the SQL Server "sa" password
# (min 8 chars, upper case, lower case, digit, symbol). Leave unset when KEY_VAULT_NAME is used.
# SA_PASSWORD=ChangeMe_Str0ng!

# Name of the installed ODBC driver (check with: Get-OdbcDriver | Where-Object Name -like "*SQL Server*")
ODBC_DRIVER=ODBC Driver 17 for SQL Server

# E-mail for Azure budget alerts (kept out of the public repo)
BUDGET_EMAIL=you@example.com
