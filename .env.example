# Copy this file to .env and fill in real values. .env is ignored by git.

# SQL Server "sa" password for the simulated on-prem ERP
# (min 8 chars, must include upper case, lower case, a digit and a symbol)
SA_PASSWORD=ChangeMe_Str0ng!

# Name of the installed ODBC driver (check with: Get-OdbcDriver | Where-Object Name -like "*SQL Server*")
ODBC_DRIVER=ODBC Driver 17 for SQL Server

# E-mail for Azure budget alerts (kept out of the public repo)
BUDGET_EMAIL=you@example.com
