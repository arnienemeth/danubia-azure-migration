// Danubia - who read or changed Key Vault secrets, and was it allowed?
// Run in: Log Analytics workspace log-danubia-dev-swc > Logs (KQL mode)
// Notes:
// - An "Authentication / Unauthorized" row right before a successful call is normal: Key Vault uses
//   challenge-based auth (the first request goes without a token and gets a 401 with sign-in details).
// - App 04b07795-8ddb-461a-bbee-02f9e1bf7b46 is Microsoft's well-known ID of the Azure CLI. Python's
//   DefaultAzureCredential reuses the 'az login' session on a developer PC, so reads show up as Azure CLI.
// - Personal Microsoft accounts carry no UPN claim, so User falls back to the name or object ID.
AzureDiagnostics
| where ResourceProvider == "MICROSOFT.KEYVAULT"
| extend AppId = tostring(column_ifexists("identity_claim_appid_g", ""))
| extend App = case(
    AppId == "04b07795-8ddb-461a-bbee-02f9e1bf7b46", "Azure CLI",
    AppId == "1950a258-227b-4e31-a9cf-717495945fc2", "Azure PowerShell",
    AppId == "c44b4083-3bb0-49c1-b47d-974e53cbdf3c", "Azure Portal",
    AppId)
| extend User = coalesce(
    tostring(column_ifexists("identity_claim_upn_s", "")),
    tostring(column_ifexists("identity_claim_http_schemas_xmlsoap_org_ws_2005_05_identity_claims_upn_s", "")),
    tostring(column_ifexists("identity_claim_unique_name_s", "")),
    tostring(column_ifexists("identity_claim_http_schemas_xmlsoap_org_ws_2005_05_identity_claims_name_s", "")),
    tostring(column_ifexists("identity_claim_oid_g", "")),
    tostring(column_ifexists("identity_claim_http_schemas_microsoft_com_identity_claims_objectidentifier_g", "")))
| extend Secret = extract(@"/secrets/([^/]+)", 1, tostring(column_ifexists("id_s", "")))
| project TimeGenerated, OperationName, ResultSignature, Secret, App, User, CallerIPAddress
| order by TimeGenerated desc
